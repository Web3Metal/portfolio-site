# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
/.output/

# operating systems and editors
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
*.pem

# debug and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.tmp
*.bak

# env files (can opt-in for committing if needed)
.env*

# generated output
/build/
/dist/
/.wrangler/
/outputs/
/work/

# vercel
.vercel

# typescript
next-env.d.ts

# local project references and preparation artifacts
/sources/
/AGENTS.md
/.pnpm-store/
/dev-server.log
/dev-server-error.log
